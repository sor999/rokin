# PostgreSQL Environment Variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=telemetry
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

# Kafka Environment Variables
KAFKA_BROKER_URL=localhost:9092
KAFKA_ZOOKEEPER_URL=localhost:2181
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181

# Application Environment Variables
API_PORT=8080
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Observability Environment Variables
METRICS_ADDR=:2112
WORKER_METRICS_PORT=2112
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
POSTGRES_EXPORTER_PORT=9187
KAFKA_EXPORTER_PORT=9308

# Simulator management (use the same private token for API and ROS; replace this example)
SIMULATOR_INTERNAL_TOKEN=
SIMULATOR_MAX_ROBOTS=20

# 개발용 Redis relay 예시. 브라우저에는 전달하지 않는다.
REALTIME_REDIS_PASSWORD=dev_realtime_only
